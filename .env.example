# EduShare Production and Local Environment Variables
# Duplicate this file to .env.local and populate the values

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Authentication & Database
# Obtained from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Storage Configuration
NEXT_PUBLIC_STORAGE_BUCKET=edushare-resources

# Server-Side Supabase Service Role Key (NEVER expose to frontend)
# Used only by administrative server functions for verified system tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# AI Study Assistant Configuration
# Gemini or OpenAI API Key for server-side summarization & grounded document Q&A
# EduShare core runs seamlessly even if this key is unset
AI_PROVIDER_API_KEY=your-gemini-or-llm-api-key-placeholder
AI_MODEL_NAME=gemini-1.5-flash
